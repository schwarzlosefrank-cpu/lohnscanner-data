  "rechtsgrundlagen": {
    "buag": {
      "name": "BUAG - Bauarbeiter-Urlaubs- und Abfertigungsgesetz",
      "paragraf": "§ 2 BUAG",
      "zitat": "Der Geltungsbereich des BUAG knuepft nicht an der Gewerbeberechtigung, sondern an der Betriebsart - somit an der tatsaechlichen Taetigkeit - an.",
      "quelle": "OGH-Rechtsprechung / DRdA"
    },
    "aueg_10": {
      "name": "AUeG § 10 - Ansprueche der Arbeitskraft",
      "paragraf": "§ 10 Abs. 1 AUeG",
      "zitat": "Bei der Beurteilung der Angemessenheit ist fuer die Dauer der Ueberlassung auf das im Beschaeftigerbetrieb vergleichbaren Arbeitnehmern fuer vergleichbare Taetigkeiten zu zahlende kollektivvertragliche Entgelt Bedacht zu nehmen.",
      "quelle": "Gesetzestext"
    },
    "aueg_4": {
      "name": "AUeG § 4 - Begriffsbestimmungen",
      "paragraf": "§ 4 Abs. 2 AUeG",
      "zitat": "Arbeitskraefteueberlassung liegt insbesondere auch vor, wenn Arbeitskraefte ihre Arbeitsleistung im Betrieb des Werkbestellers in Erfuellung von Werkvertraegen erbringen, aber kein unterscheidbares Werk herstellen, nicht vorwiegend mit eigenem Material arbeiten, organisatorisch eingegliedert sind oder keine Erfolgshaftung besteht.",
      "quelle": "Gesetzestext"
    },
    "ogh_aueg": {
      "name": "OGH zur Arbeitskraefteueberlassung",
      "aktenzeichen": "OGH 8 ObA 63/20b",
      "zitat": "Nach staendiger Rechtsprechung des OGH liegt eine Arbeitskraefteueberlassung bereits dann vor, wenn auch nur ein einziger der Tatbestaende erfuellt ist.",
      "quelle": "OGH 23.10.2020"
    },
    "ogh_bau_1": {
      "name": "OGH zum Arbeitsort",
      "aktenzeichen": "OGH 9 ObA 327/89",
      "zitat": "Ein Kraftfahrer hat nicht dort seinen staendigen Arbeitsort, wo er mit der Durchfuehrung der ihm aufgetragenen Transporte regelmaessig beginnt.",
      "quelle": "OGH"
    },
    "ogh_bau_2": {
      "name": "OGH zur Arbeitspflicht",
      "aktenzeichen": "OGH 9 ObA 119/08f",
      "zitat": "Zum wesentlichen Inhalt der Arbeitspflicht gehoert der Ort, an dem die Leistung zu erbringen ist.",
      "quelle": "OGH 24.02.2009"
    },
    "entsendeplattform": {
      "name": "Entsendeplattform.at",
      "quelle": "BMF/BMAW",
      "zitat": "Ob Arbeiten als Bauarbeiten anzusehen sind, richtet sich nicht nach der Gewerbeberechtigung, sondern nach der tatsaechlich in Oesterreich ausgeuebten Taetigkeit."
    },
    "wko_grundsatz": {
      "name": "WKO - Grundsatz KV-Zuordnung",
      "zitat": "Welcher Kollektivvertrag im Einzelfall anzuwenden ist, bestimmt sich in erster Linie nach der Gewerbeberechtigung des Unternehmens. Die fachliche Taetigkeit des Arbeitnehmers ist nicht ausschlaggebend.",
      "quelle": "WKO FAQ Arbeitsvertragsrecht"
    }
  },

